<Window
    x:Class="ITHS_LABB_2_Quiz_Configurator.Dialogs.CreateNewPackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ITHS_LABB_2_Quiz_Configurator.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="New Question Pack"
    Width="220"
    Height="260"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d"
    >
    <StackPanel Margin="16">
        <Label Content="Pack Name (required):" FontWeight="Bold" />
        <TextBox x:Name="packName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <Label Content="Difficulty" FontWeight="Bold" />
        <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding Difficulty}" />

        <Grid>
            <Label Content="Time Limit:" FontWeight="Bold" />
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding TimeLimitInSeconds}"
                />
        </Grid>
        <Slider
            IsSnapToTickEnabled="True"
            Maximum="120"
            Minimum="5"
            TickFrequency="5"
            TickPlacement="BottomRight"
            Value="{Binding TimeLimitInSeconds}"
            />

        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <Button
                Margin="16,0"
                Padding="8,0"
                HorizontalAlignment="Left"
                Content="Cancel"
                IsCancel="True"
                />
            <Button
                Margin="16,0"
                Padding="8,0"
                HorizontalAlignment="Right"
                Click="Create_Click"
                Content="Create"
                IsEnabled="{Binding HasValidName}"
                />
        </StackPanel>
    </StackPanel>
</Window>
