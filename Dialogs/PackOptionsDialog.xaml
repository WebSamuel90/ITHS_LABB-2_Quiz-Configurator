<Window
    x:Class="ITHS_LABB_2_Quiz_Configurator.Dialogs.PackOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ITHS_LABB_2_Quiz_Configurator.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Pack Options"
    Width="200"
    Height="240"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d"
    >
    <StackPanel Margin="16">
        <Label Content="Pack Name:" FontWeight="Bold" />
        <TextBox Text="{Binding ActivePack.Name}" />

        <Label Content="Difficulty" FontWeight="Bold" />
        <ComboBox ItemsSource="{Binding ActivePack.Difficulties}" SelectedItem="{Binding ActivePack.Difficulty}" />

        <Grid>
            <Label Content="Time Limit:" FontWeight="Bold" />
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding ActivePack.TimeLimitInSeconds}"
                />
        </Grid>
        <Slider
            IsSnapToTickEnabled="True"
            Maximum="120"
            Minimum="5"
            TickFrequency="5"
            TickPlacement="BottomRight"
            Value="{Binding ActivePack.TimeLimitInSeconds}"
            />
    </StackPanel>
</Window>
