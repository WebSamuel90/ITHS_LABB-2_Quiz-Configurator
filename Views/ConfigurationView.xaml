<UserControl
    x:Class="ITHS_LABB_2_Quiz_Configurator.Views.ConfigurationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:ITHS_LABB_2_Quiz_Configurator.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding ConfigurationViewModel}"
    mc:Ignorable="d"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <Label
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{Binding ActivePack.Name}"
                FontWeight="Bold"
                />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="20"
                    Height="20"
                    Margin="4"
                    >
                    <fa:IconImage Icon="Sliders" />
                </Button>
                <Button
                    Width="20"
                    Height="20"
                    Margin="4"
                    >
                    <fa:IconImage Icon="Plus" />
                </Button>

                <Button
                    Width="20"
                    Height="20"
                    Margin="4"
                    >
                    <fa:IconImage Icon="Minus" />
                </Button>
            </StackPanel>

        </DockPanel>

        <ListBox
            Grid.Row="1"
            Margin="4"
            ItemsSource="{Binding ActivePack.Questions}"
            SelectedItem="{Binding SelectedQuestion}"
            >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Left">
                        <Label Content="Question:" FontWeight="Bold" />
                        <TextBlock Text="{Binding Query}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="16,0"
            DataContext="{Binding SelectedQuestion}"
            >
            <Label Content="Question" FontWeight="Bold" />
            <TextBox
                Height="80"
                Margin="0,0,0,40"
                Text="{Binding Query}"
                />

            <Label Content="Correct Answer" FontWeight="Bold" />
            <TextBox Text="{Binding CorrectAnswer}" />

            <Label Content="First Incorrect Answer" FontWeight="Bold" />
            <TextBox Text="{Binding IncorrectAnswers[0]}" />

            <Label Content="Second Incorrect Answer" FontWeight="Bold" />
            <TextBox Text="{Binding IncorrectAnswers[1]}" />

            <Label Content="Third Incorrect Answer" FontWeight="Bold" />
            <TextBox Text="{Binding IncorrectAnswers[2]}" />
        </StackPanel>
    </Grid>
</UserControl>
