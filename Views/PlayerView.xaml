<UserControl
    x:Class="ITHS_LABB_2_Quiz_Configurator.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ITHS_LABB_2_Quiz_Configurator.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PlayerViewRoot"
    d:DesignHeight="500"
    d:DesignWidth="800"
    mc:Ignorable="d"
    >
    <Grid>


        <Grid x:Name="QuizView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsQuizFinished}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Margin="28"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FontSize="32"
                FontWeight="Bold"
                Text="{Binding SecondsRemaining}"
                />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,16,0,16"
                    Padding="28,0,28,0"
                    FontSize="42"
                    Text="{Binding CurrentQuestion.Query}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    />
                <TextBlock HorizontalAlignment="Center" FontSize="18">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}Question {0} of {1}">
                            <Binding Path="CurrentQuestionNumber" />
                            <Binding Path="QuizQuestions.Count" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <Grid Grid.Row="1">

                <ItemsControl
                    Width="520"
                    Height="200"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding CurrentAnswers}"
                    >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="8"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Command="{Binding DataContext.SubmitAnswerCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                >

                                <Grid>
                                    <Image
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Source="/Assets/incorrect.png"
                                        >
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsRevealed}" Value="True" />
                                                            <Condition Binding="{Binding IsCorrect}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <Image
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Source="/Assets/correct.png"
                                        >
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsRevealed}" Value="True" />
                                                            <Condition Binding="{Binding IsCorrect}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding Text}"
                                        />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Grid>
        <Grid x:Name="ResultView">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsQuizFinished}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontSize="40" Text="Complete!" />
                <TextBlock Margin="0,8,0,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}You got {0} out of {1} answers correct">
                            <Binding Path="Score" />
                            <Binding Path="QuizQuestions.Count" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Button
                    Margin="24"
                    Padding="4"
                    Command="{Binding RestartQuizCommand}"
                    >
                    <TextBlock Text="Restart!" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
