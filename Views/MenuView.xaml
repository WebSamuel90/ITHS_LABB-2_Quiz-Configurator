<UserControl
    x:Class="ITHS_LABB_2_Quiz_Configurator.Views.MenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:ITHS_LABB_2_Quiz_Configurator.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    >
    <Menu>
        <MenuItem Header="_File">
            <MenuItem
                Command="{Binding OpenCreateNewPackCommand}"
                Header="New Question Pack"
                Icon="{fa:Icon FolderPlus}"
                />
            <MenuItem
                Header="Select Question Pack"
                Icon="{fa:Icon Folderopen}"
                ItemsSource="{Binding Packs}"
                >
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="MenuItem.Header" Value="{Binding Name}" />
                        <Setter Property="MenuItem.Command" Value="{Binding DataContext.SelectQuestionPackCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>

                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem
                Command="{Binding DeletePackCommand}"
                CommandParameter="{Binding ActivePack}"
                Header="Delete Question Pack"
                Icon="{fa:Icon FolderMinus}"
                IsEnabled="{Binding HasMoreThanOne}"
                />
            <Separator />

            <MenuItem
                Header="Import Questions"
                Icon="{fa:Icon CloudArrowDown}"
                InputGestureText="Ctrl+I"
                />
            <Separator />
            <MenuItem
                Header="Exit"
                Icon="{fa:Icon DoorOpen}"
                InputGestureText="Alt+F4"
                />
        </MenuItem>

        <MenuItem Header="_Edit">
            <MenuItem
                Command="{Binding ConfigurationViewModel.CreateNewQuestionCommand}"
                Header="Add Question"
                Icon="{fa:Icon Plus}"
                InputGestureText="Insert"
                />
            <MenuItem
                Command="{Binding ConfigurationViewModel.DeleteQuestionCommand}"
                Header="Remove Question"
                Icon="{fa:Icon Minus}"
                InputGestureText="Delete"
                />
            <MenuItem
                Command="{Binding ConfigurationViewModel.OpenPackSettingsCommand}"
                Header="Pack Options"
                Icon="{fa:Icon Sliders}"
                InputGestureText="Ctrl+O"
                />
        </MenuItem>

        <MenuItem Header="_View">
            <MenuItem
                Command="{Binding ShowPlayerViewModelCommand}"
                Header="Play"
                Icon="{fa:Icon Play}"
                InputGestureText="Ctrl+P"
                />
            <MenuItem
                Command="{Binding ShowConfigurationViewModelCommand}"
                Header="Edit"
                Icon="{fa:Icon Edit}"
                InputGestureText="Ctrl+E"
                />
            <Separator />
            <MenuItem
                Header="Fullscreen"
                Icon="{fa:Icon Expand}"
                InputGestureText="Alt+Enter"
                />
        </MenuItem>
    </Menu>
</UserControl>
