<Window
    x:Class="ITHS_LABB_3_Quiz_Configurator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ITHS_LABB_3_Quiz_Configurator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:ITHS_LABB_3_Quiz_Configurator.Views"
    xmlns:vm="clr-namespace:ITHS_LABB_3_Quiz_Configurator.ViewModels"
    Title="Quiz Configurator"
    Width="800"
    Height="500"
    MinWidth="800"
    MinHeight="600"
    mc:Ignorable="d"
    >
    <Window.InputBindings>
        <KeyBinding
            Key="I"
            Command="{Binding ImportQuestionsCommand}"
            Modifiers="Control"
            />

        <KeyBinding Key="Insert" Command="{Binding ConfigurationViewModel.CreateNewQuestionCommand}" />

        <KeyBinding Key="Delete" Command="{Binding ConfigurationViewModel.DeleteQuestionCommand}" />

        <KeyBinding
            Key="O"
            Command="{Binding ConfigurationViewModel.OpenPackSettingsCommand}"
            Modifiers="Control"
            />

        <KeyBinding
            Key="P"
            Command="{Binding ShowPlayerViewModelCommand}"
            Modifiers="Control"
            />

        <KeyBinding
            Key="E"
            Command="{Binding ShowConfigurationViewModelCommand}"
            Modifiers="Control"
            />

        <KeyBinding
            Key="Enter"
            Command="{Binding ToggleFullscreenCommand}"
            Modifiers="Alt"
            />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}">
            <views:ConfigurationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
            <views:PlayerView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:MenuView Grid.Row="0" />

        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
